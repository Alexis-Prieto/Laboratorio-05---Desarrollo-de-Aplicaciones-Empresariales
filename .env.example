# Copy this file as .env and adjust the values for your machine.

# Secret key used to sign sessions and tokens. Generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-generate-a-random-secret-key

# Development flag. Set to False outside local development.
DJANGO_DEBUG=True

# Comma-separated list of accepted host names.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
